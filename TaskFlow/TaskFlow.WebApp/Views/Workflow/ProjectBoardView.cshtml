@model TaskFlow.Domain.Entities.Projects.Project;

@{
    ViewData["Title"] = "View";
    Layout = "_Separated_Layout";
}


<style>

     body {
          background-color: #1e1e2f;
          color: black;
     }
     /* Make the board-column relative for absolute positioning of the plus sign */
     .board-column {
          position: relative;
     }

          /* Style and position the plus sign */
          .board-column .add-column-plus {
               font-size: 1.5rem;
               color: #f8f9fa;
               opacity: 0;
               transition: opacity 0.3s ease-in-out;
               cursor: pointer;
               padding: 5px;
               background-color: #2b2b3c
          }

          .board-column:hover .add-column-plus,
          .board-column:hover .three-dots {
               opacity: 1;
          }

          .board-column .three-dots {
               font-size: 1.5rem; /* Make it visible */
               color: #f8f9fa; /* Light color for visibility on dark background */
               opacity: 0;
               transition: opacity 0.3s ease-in-out; /* Smooth transition */
               cursor: pointer;
               padding: 5px;
               background-color: #2b2b3c
          }

     .btn.dropdown-toggle::after {
          display: none;
     }

     .plus-column {
          position: relative;
          bottom: 20%;
          background-color: #2b2b3c;
          border-radius: 10px;
          padding: 15px;
          margin: 10px;
          min-height: 10px;
          max-height: 20px;
     }

     .board-column {
          background-color: #2b2b3c;
          border-radius: 10px;
          padding: 15px;
          margin: 10px;
          min-height: 410px;
          max-height: 500px;
          overflow-y: auto;
     }

     .task-card {
          background-color: #3c3c4e;
          border: none;
          border-radius: 8px;
          margin-bottom: 10px;
          color: white;
     }

          .task-card h6 {
               font-size: 16px;
          }

     .add-task {
          background: none;
          color: #bbb;
          border: 1px dashed #777;
          border-radius: 8px;
          padding: 6px;
          cursor: pointer;
     }

     #basic-button {
          opacity: 0.4;
     }

     /* .bg-hex-30{
               background: color #A3A3FF;
          } */


     .projectNavbar {
          background-color: #2b2b3c;
          position: relative;
          bottom: 20px;
     }

     .ProjectContainer {
          position: relative;
          bottom: 45px;
     }

     .task-card .text-xs {
          font-size: 0.8rem;
     }

     .task-card .dropdown-menu {
          min-width: 200px;
     }

</style>


@section Menu{
    <script src="https://unpkg.com/feather-icons"></script>
    <nav class="projectNavbar navbar navbar-expand">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav gap-3 ms-0">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="#"><i data-feather="edit"></i> Overview</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="#"><i data-feather="list"></i> List</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="#"><i data-feather="clipboard"></i> Board</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="#"><i data-feather="calendar"></i> Calendar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="#"><i data-feather="message-square"></i> Messages</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


     <div class="modal fade" id="newSectionModal" tabindex="-1" aria-labelledby="newSectionModalLabel" aria-hidden="true">

          <div class="modal-dialog modal-dialog-centered">

               <div class="modal-content bg-dark text-white">

                    <div class="modal-header border-0">

                         <h5 class="modal-title text-white" id="newSectionModal">New section</h5>

                         <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>

                    </div>

                    <div class="modal-body">

                         <form id="create-section-form">

                              <label for="SectionName">Section Name:</label>

                              <input type="text" id="SectionName" name="SectionName" value="" required />

                              <input type="submit" value="Submit" class="submit" />

                              <div id="project-data" data-project-id="@Model.Id"></div>

                         </form>

                    </div>

               </div>

          </div>

     </div>



     <div class="modal fade" id="newTaskModal" tabindex="-1" aria-labelledby="newTaskModalLabel" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
               <div class="modal-content bg-dark text-white">
                    <div class="modal-header border-0">
                         <h5 class="modal-title text-white" id="newSectionModal">New Task</h5>
                         <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">

                         <form id="create-task-form">
                              <label for="SectionName">Task Name:</label>
                              <input type="text" id="TaskName" name="TaskName" value="" required />
                              <input type="submit" value="Submit" class="submit" />
                              <div id="project-data"></div>
                         </form>
                    </div>
               </div>
          </div>
     </div>


    <div class="ProjectContainer container-fluid py-4">
        <h2 class="text-white mb-4">Project Board</h2>
        <div class="ProjectDiv row flex-nowrap overflow-auto align-items-start" id="project-board-container">
            
            @if (Model.Sections != null)
            {
                @foreach (var mySection in Model.Sections)
                {
                         <div class="col-md-3 board-column" data-section-id="@mySection.Id">
                        <h5 class="mb-3 text-white d-flex justify-content-between align-items-center board-header">
                                   <span>@mySection.Name</span>
                            <div class="d-flex gap-3 board-actions">
                                        <button class="btn btn-sm p-0 m-0 bg-transparent border-0 add-task-btn" data-section-id="@mySection.Id">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-plus add-column-plus" viewBox="0 0 16 16">
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                                    </svg>
                                </button>
                                <div class="btn-group">
                                    <button type="button" class="btn p-0 m-0 bg-transparent border-0 dropdown-toggle"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor"
                                             class="bi bi-three-dots three-dots" viewBox="0 0 16 16">
                                            <path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"/>
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item delete-section-btn">Delete Section</a></li>
                                    </ul>
                                </div>
                            </div>
                        </h5>

                        @if (mySection.Tasks != null)
                        {
                            @foreach (var task in mySection.Tasks)
                            {
                                 <div class="card task-card p-3 mb-2" data-task-id="@task.Id" data-section-id="@mySection.Id">
                                   <div class="d-flex justify-content-between align-items-center task-header">
                                        <h6>@task.Title</h6>
                                        <div class="task-actions d-flex gap-2">
                                             <button class="btn btn-sm p-0 m-0 bg-transparent border-0 add-subtask-btn" data-task-id="@task.Id" title="Add Subtask">
                                                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16">
                                                       <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                                                  </svg>
                                             </button>
                                             <button class="btn btn-sm p-0 m-0 bg-transparent border-0" title="Remove Task">
                                                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash" viewBox="0 0 16 16">
                                                       <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                                                  </svg>
                                             </button>
                                        </div>
                                   </div>

                                   <!-- Two-column row: due date and subtask dropdown -->
                                   <div class="d-flex justify-content-between align-items-center mt-2">  
                                        <span class="text-xs text-muted">

                                             Due: @(task.DueDate?.ToString("MM/dd/yyyy") ?? "--")
                                        </span>
                                        <!-- Subtask dropdown -->
                                        <div class="dropdown">
                                             <button class="btn btn-sm bg-transparent border-0 text-muted d-flex align-items-center" data-bs-toggle="dropdown" aria-expanded="false">
                                                  <span class="ms-1">@task.Tasks?.Count() ?? 0</span>
                                             </button>
                                             <ul class="dropdown-menu dropdown-menu-end p-2 small shadow-sm">
                                                  @if (task.Tasks != null && task.Tasks.Any())
                                                  {
                                                       foreach (var sub in task.Tasks)
                                                       {
                                                            <li class="dropdown-item">
                                                                 <div class="d-flex flex-column">
                                                                      <strong>@sub.Title</strong>
                                                                      <small class="text-muted">Due: @(sub.DueDate?.ToString("MM/dd/yyyy") ?? "--")</small>
                                                                 </div>
                                                            </li>
                                                       }
                                                  }
                                                  else
                                                  {
                                                       <li class="dropdown-item text-muted">No subtasks</li>
                                                  }
                                             </ul>
                                        </div>
                                   </div>
                              </div>
                            }
                        }
                    </div>
                }
            }
            
            <div class="col-md-3 board-column d-flex align-items-center justify-content-center" id="basic-button" onclick="showSectionModal()">
                <button class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center"
                        style="width: 60px; height: 60px; max-width: 60px; max-height: 60px; font-size: 2rem; border-width: 2px;">
                    +
                </button>
            </div>
        </div>
    </div>
}